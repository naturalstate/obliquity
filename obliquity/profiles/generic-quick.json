{
  "name": "generic-quick",
  "description": "Fast first-pass content discovery with light extensions and shallow recursion.",
  "stages": [
    {
      "name": "common-directories",
      "wordlist": "/usr/share/seclists/Discovery/Web-Content/common.txt",
      "extensions": [],
      "recursion": false,
      "status_codes": [200, 204, 301, 302, 307, 308, 401, 403]
    },
    {
      "name": "common-light-files",
      "wordlist": "/usr/share/seclists/Discovery/Web-Content/common.txt",
      "extensions": ["html", "txt", "bak", "old", "zip"],
      "recursion": false,
      "status_codes": [200, 204, 301, 302, 307, 308, 401, 403]
    },
    {
      "name": "shallow-recursion",
      "wordlist": "/usr/share/seclists/Discovery/Web-Content/common.txt",
      "extensions": [],
      "recursion": true,
      "depth": 1,
      "status_codes": [200, 204, 301, 302, 307, 308, 401, 403]
    }
  ]
}
